{
  "version": 2,
  "rewrites": [
    { "source": "/dental-demo/css/(.*)", "destination": "/css/$1" },
    { "source": "/dental-demo/js/(.*)", "destination": "/js/$1" },
    { "source": "/dental-demo/(.*)", "destination": "/$1" },
    { "source": "/dental-demo/?$", "destination": "/index.html" },
    { "source": "/denal-demo/css/(.*)", "destination": "/css/$1" },
    { "source": "/denal-demo/js/(.*)", "destination": "/js/$1" },
    { "source": "/denal-demo/(.*)", "destination": "/$1" },
    { "source": "/denal-demo/?$", "destination": "/index.html" },
    { "source": "/css/(.*)", "destination": "/css/$1" },
    { "source": "/js/(.*)", "destination": "/js/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
